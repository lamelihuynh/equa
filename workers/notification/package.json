{
  "name": "@equa/notification-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "test": "vitest run src --passWithNoTests",
    "test:coverage": "vitest run src --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@equa/contracts": "workspace:*",
    "amqplib": "0.10.9",
    "dotenv": "17.2.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.7",
    "@types/pg": "8.15.5",
    "tsx": "4.23.12"
  }
}
