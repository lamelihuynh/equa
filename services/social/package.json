{
  "name": "@equa/social-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "lint": "eslint src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@equa/contracts": "workspace:*",
    "dotenv": "17.2.2",
    "fastify": "5.6.2",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.23.12"
  }
}
