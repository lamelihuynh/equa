# Copy to .env for local development. Never commit real credentials.
COMPOSE_PROJECT_NAME=equa
POSTGRES_USER=equa_local
POSTGRES_PASSWORD=equa_local_only
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_USER=equa_local
RABBITMQ_PASSWORD=equa_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ROOT_USER=equa_local
MINIO_ROOT_PASSWORD=equa_local_only_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Local application processes
IDENTITY_PORT=3001
LEDGER_PORT=3002
SOCIAL_PORT=3005
PLATFORM_PORT=3003
NOTIFICATION_PORT=3004
WEB_PORT=3000

IDENTITY_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_identity
IDENTITY_JWT_SECRET=replace-with-a-long-random-local-development-secret-at-least-32-characters
IDENTITY_JWT_ISSUER=equa-identity
IDENTITY_JWT_AUDIENCE=equa-clients
IDENTITY_SERVICE_KEY=replace-with-a-long-local-service-key
IDENTITY_ACCESS_TOKEN_MINUTES=15
IDENTITY_REFRESH_TOKEN_DAYS=30
APP_WEB_URL=http://localhost:3000
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Equa <no-reply@localhost>
# Staging only: set these in Render Environment Variables, never commit a real key.
# RESEND_API_KEY=
LEDGER_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_ledger
SOCIAL_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_social
IDENTITY_URL=http://localhost:3001
SOCIAL_URL=http://localhost:3005
LEDGER_URL=http://localhost:3002
SOCIAL_SERVICE_KEY=replace-with-social-to-ledger-key
LEDGER_SERVICE_KEY=replace-with-ledger-to-social-key
LEDGER_FEED_CURSOR_SECRET=replace-with-a-different-long-local-feed-secret
AUTOMATION_SYNC_SERVICE_KEY=replace-with-automation-to-ledger-key
PLATFORM_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_platform
NOTIFICATION_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_notification
AUTOMATION_SYNC_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_automation_sync
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://equa_local:equa_local_only@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=equa_local
S3_SECRET_KEY=equa_local_only_change_me
S3_AVATAR_BUCKET=equa-avatars
NEXT_PUBLIC_AVATAR_ORIGIN=http://localhost:9000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1
