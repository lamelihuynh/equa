# Copy to .env for local development. Never commit real credentials.
COMPOSE_PROJECT_NAME=equa
POSTGRES_USER=equa_local
POSTGRES_PASSWORD=equa_local_only
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_USER=equa_local
RABBITMQ_PASSWORD=equa_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ROOT_USER=equa_local
MINIO_ROOT_PASSWORD=equa_local_only_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Local application processes
IDENTITY_PORT=3001
LEDGER_PORT=3002
PLATFORM_PORT=3003
NOTIFICATION_PORT=3004
WEB_PORT=3000

IDENTITY_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_identity
LEDGER_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_ledger
PLATFORM_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_platform
NOTIFICATION_DATABASE_URL=postgresql://equa_local:equa_local_only@localhost:15432/equa_notification
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://equa_local:equa_local_only@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=equa_local
S3_SECRET_KEY=equa_local_only_change_me
SMTP_HOST=localhost
SMTP_PORT=1025
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1
